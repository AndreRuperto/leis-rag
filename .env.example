# Uso local. Troque a senha antes de publicar em qualquer servidor.
POSTGRES_PASSWORD=leis_local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Pesquisa externa autônoma: prioriza portais oficiais, consulta também fontes
# acadêmicas e especializadas conforme o assunto. Requer a chave OpenAI
# E um código privado de acesso (nunca embutir esse código no JavaScript).
LEGAL_WEB_SEARCH_ENABLED=0
LEGAL_AI_ACCESS_TOKEN=
# Limites conservadores de uso da API paga; quota diária persistida no banco.
LEGAL_AI_DAILY_LIMIT=25
LEGAL_AI_RATE_PER_MIN=4
OPENAI_WEB_MODEL=gpt-5-mini
# Vetores são opcionais: exigem download de um modelo de embeddings.
INSTALL_EMBEDDINGS=0
EMBEDDINGS_ENABLED=0
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
