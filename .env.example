# Uso local. Troque a senha antes de publicar em qualquer servidor.
POSTGRES_PASSWORD=leis_local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Pesquisa externa em fontes oficiais, opcional (custa chamadas de busca).
# NÃO ative em servidor público sem autenticação, rate limit e orçamento controlado.
LEGAL_WEB_SEARCH_ENABLED=0
OPENAI_WEB_MODEL=gpt-5-mini
# Vetores são opcionais: exigem download de um modelo de embeddings.
INSTALL_EMBEDDINGS=0
EMBEDDINGS_ENABLED=0
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
